<Project Sdk="Microsoft.NET.Sdk">

  <!-- Self-contained test console for the patcher's internal classes (no test framework needed).
       Build: dotnet build patcher/TpcJpPatch.Tests -c Debug
       Run:   patcher/TpcJpPatch.Tests/bin/Debug/net48/TpcJpPatch.Tests.exe   (exit code = number of failures)
       Must be built in Debug: the patcher's test hooks (TPCJP_PREFS_ROOT, TPCJP_APPDATA) exist only there,
       and the runner refuses to start when they are not active. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TpcJpPatch.Tests</AssemblyName>
    <RootNamespace>TpcJpPatch.Tests</RootNamespace>
    <Prefer32Bit>false</Prefer32Bit>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../TpcJpPatch/TpcJpPatch.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="gen_vectors.py" />
  </ItemGroup>

</Project>
